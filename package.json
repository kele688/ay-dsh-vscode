{
  "name": "ay-dsh-vscode",
  "displayName": "ay-dsh-vscode",
  "description": "AI coding agent powered by DeepSeek Harness (DSH): multi-agent orchestration, long-running goal tasks, transparent tool usage, sandboxed approvals — in a Kilo Code style chat.",
  "version": "0.5.2",
  "publisher": "kele688",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kele688/ay-dsh-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "agent",
    "ai",
    "coding",
    "kilocode",
    "claude-code"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:dshVscode.chatView",
    "onCommand:dshVscode.explainSelection",
    "onCommand:dshVscode.runOnSelection",
    "onCommand:dshVscode.fixDiagnostics",
    "onCommand:dshVscode.addSelectionRef",
    "onCommand:dshVscode.configure",
    "onCommand:dshVscode.openWorkspace",
    "onCommand:dshVscode.focus",
    "onCommand:dshVscode.newSession",
    "onCommand:dshVscode.stop",
    "onCommand:dshVscode.restartHost"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshVscode",
          "title": "ay-dsh-vscode",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "dshVscode": [
        {
          "id": "dshVscode.chatView",
          "name": "ay-dsh-vscode",
          "type": "webview",
          "icon": "media/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "dshVscode.focus",
        "title": "DSH: Open Agent Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dshVscode.newSession",
        "title": "DSH: New Session",
        "icon": "$(add)"
      },
      {
        "command": "dshVscode.stop",
        "title": "DSH: Stop Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dshVscode.configure",
        "title": "DSH: Configure (API Key / Model / Permissions)",
        "icon": "$(gear)"
      },
      {
        "command": "dshVscode.explainSelection",
        "title": "DSH: Explain Selection"
      },
      {
        "command": "dshVscode.runOnSelection",
        "title": "DSH: Run Agent on Selection"
      },
      {
        "command": "dshVscode.fixDiagnostics",
        "title": "DSH: Fix Problems in File"
      },
      {
        "command": "dshVscode.addSelectionRef",
        "title": "DSH: Reference Selection in Chat (Ctrl+K Ctrl+I)",
        "icon": "$(quote)"
      },
      {
        "command": "dshVscode.resetDshRuntime",
        "title": "DSH: Reset Runtime to Bundled"
      },
      {
        "command": "dshVscode.restartHost",
        "title": "DSH: Restart Host to Apply Saved Settings",
        "icon": "$(sync)"
      }
    ],
    "keybindings": [
      {
        "command": "dshVscode.addSelectionRef",
        "key": "ctrl+k ctrl+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "dshVscode.addSelectionRef",
        "key": "cmd+k cmd+i",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dshVscode.newSession",
          "when": "view == dshVscode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "dshVscode.stop",
          "when": "view == dshVscode.chatView",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dshVscode.explainSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        },
        {
          "command": "dshVscode.runOnSelection",
          "when": "editorHasSelection",
          "group": "dsh@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dshVscode.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "dshVscode.runOnSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "ay-dsh-vscode",
      "properties": {
        "dshVscode.apiKey": {
          "type": "string",
          "markdownDescription": "DeepSeek API Key。留空时读取环境变量 `DEEPSEEK_API_KEY`。存储在 VS Code 密钥库中。",
          "secure": true
        },
        "dshVscode.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "markdownDescription": "默认模型 id（DeepSeek 官方路由）。可填 `deepseek-v4-pro` 等。"
        },
        "dshVscode.baseUrl": {
          "type": "string",
          "markdownDescription": "可选：自定义 OpenAI 兼容 Base URL（等价于环境变量 `DEEPSEEK_BASE_URL`）。留空使用官方 API。"
        },
        "dshVscode.permissionMode": {
          "type": "string",
          "enum": [
            "workspace-write",
            "read-only",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "markdownDescription": "文件沙箱模式：`workspace-write` 仅允许写工作区（越界操作弹审批）；`read-only` 只读；`danger-full-access` 完全访问且不再审批。"
        },
        "dshVscode.nodePath": {
          "type": "string",
          "markdownDescription": "可选：agent 宿主进程使用的 Node 可执行文件路径。留空时使用 VS Code 内置 Node（`ELECTRON_RUN_AS_NODE`）。",
          "default": ""
        },
        "dshVscode.defaultWorkspace": {
          "type": "string",
          "markdownDescription": "未打开工作区文件夹时，Agent 使用的默认工作目录（生成的文件保存位置）。留空使用 `~/ay-dsh-workspace`。",
          "default": ""
        },
        "dshVscode.maxOutputChars": {
          "type": "number",
          "default": 40000,
          "markdownDescription": "UI 中单个工具结果/消息的最大渲染字符数（超出折叠）。"
        },
        "dshVscode.maxSteps": {
          "type": "number",
          "default": 100,
          "markdownDescription": "单次任务的最大思考轮次（step 上限，借鉴 dsh web）。达到上限自动停止，防止任务无限循环。设为 0 表示不限制。"
        },
        "dshVscode.subagentMaxDepth": {
          "type": "number",
          "default": 3,
          "markdownDescription": "子代理递归深度上限（对应 DSH tool-subagent 的 maxDepth，默认与 dsh web 一致）。"
        },
        "dshVscode.maxParallelSubagents": {
          "type": "number",
          "default": 5,
          "markdownDescription": "多 Agent 模式下并行子代理数量上限（提示词级约束）。"
        },
        "dshVscode.autoCompaction": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "上下文自动压缩：接近上限时自动归纳为摘要，释放上下文空间。"
        },
        "dshVscode.compactionThresholdRatio": {
          "type": "number",
          "default": 0.8,
          "minimum": 0.1,
          "maximum": 1,
          "markdownDescription": "上下文自动压缩触发比例：上下文用到窗口的多少比例时触发（10% ~ 100%，默认 80%，设置存小数）。"
        },
        "dshVscode.compactionMaxTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 1,
          "markdownDescription": "上下文自动压缩摘要的 token 上限（默认 8192）。"
        },
        "dshVscode.autoApproveRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string",
                "markdownDescription": "工具名（如 glob / grep / read）。DSH 内核暂未提供具体命令参数，仅支持工具级匹配，不支持带参数命令。",
                "default": ""
              },
              "action": {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ],
                "default": "allow",
                "markdownDescription": "allow=自动允许，ask=询问，deny=拒绝。"
              }
            }
          },
          "markdownDescription": "自动授权规则（工具级）：命中的工具调用按动作处理（allow 自动允许 / ask 询问 / deny 拒绝），不弹审批框。"
        },
        "dshVscode.rotateBytes": {
          "type": "number",
          "default": 10,
          "markdownDescription": "会话日志轮转阈值（MB）：超过后自动轮转创建新会话继续（默认 10）。"
        },
        "dshVscode.rotateSummary": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "轮转时用 LLM 对最近对话生成摘要注入新会话；关闭则直接转移最近消息原文。"
        },
        "dshVscode.rotateFallbackMsgs": {
          "type": "number",
          "default": 5,
          "markdownDescription": "LLM 摘要不可用时保留的最近消息条数（默认 5）。"
        },
        "dshVscode.enableCustom": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用定制：宿主启动时把“用户定制品格”（ay-dsh-custom.md）内容注入系统提示词。"
        },
        "dshVscode.enableLearning": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用经验：宿主启动时把“自动学习经验”（ay-dsh-learning.md）内容注入系统提示词。"
        },
        "dshVscode.enableAutoLearn": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启动学习：宿主在对话中自动提炼用户明确提出的规则/被肯定的经验，写入学习文件。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-base": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-headless": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@img/sharp-wasm32": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4"
  }
}
