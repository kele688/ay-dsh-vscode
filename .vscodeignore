# 构建产物 / 运行时
dist/**
media/**
release/**
*.vsix
vsce.log
*.log

# 源码与开发产物（node_modules 保留：DSH 内核依赖必须打包进 VSIX）
src/**
scripts/**
tsconfig.json
out/**
*.tsbuildinfo
.vscode/**
.git/**
.gitignore
.github/**
docs/**
EXPERIENCE-REVIEW.md
**/*.map
**/*.d.ts

# 保留项
!dist/extension.js
!host/**
!media/chat.js
!media/chat.css
!media/config-panel.js
!media/config-panel.css
!media/icon.svg
!media/icon.png
!package.json
!README.md
!LICENSE
# 第三方声明必须随 VSIX 分发（MIT 再分发需保留版权声明；node_modules 内各包
# LICENSE 已被下方裁剪规则排除，本文件是唯一的合规载体）
!THIRD-PARTY-NOTICES.md

# ⚠️ 原"依赖裁剪"区块（23 条）已全部移除——经逐条核查（release/verdict.mjs，
#    依据：根 dependencies 闭包 + base/headless cordis.patch.yml 插件行 + 源码 import）
#    结论是**没有一条可以安全保留**：
#   - 内核 0.1.0-rc.6 起 dsh-base cordis.patch.yml 将 llm-pi-ai（L95）与
#     session-telemetry-otel（L148）挂载为 dormant 插件行：boot 时 cordis-plugin-loader
#     必须 import 它们，缺任意一环即 "Cannot find package …" → host boot failed。
#   - llm-pi-ai → @earendil-works/pi-ai → 9 个 provider SDK（anthropic/mistral/google/
#     aws-sdk/smithy/openai/typebox/opentelemetry…）+ 传递闭包（node-fetch、gaxios、
#     protobufjs、web-streams-polyfill 等 20 条全部命中）。
#   - dsh-session-telemetry 虽不在 npm 依赖声明中，但被 otel 插件 lib/index.js、
#     lib/invariant.js 静态 import（隐式依赖，npm 恰好安装），同样必须随包分发。
#   原注释假设"仅被已禁用插件引用"与 dormant 挂载机制冲突，已失效。
#   真实瘦身空间仍保留：下方内部裁剪（src/types/test/d.ts/map/文档/许可）不破坏
#   运行时解析；vsce 本身按 npm list --production 只打包生产依赖，devDependencies 不进 VSIX。
#   如未来内核再演进，请以 release/closure.mjs（闭包计算）+ release/verdict.mjs（逐条判定）
#   复核后再动裁剪。

# ── 依赖内部裁剪（agent-host 已 esbuild bundle 成单文件，运行时不再解析
#    这些源文件；保留 lib/ 编译产物与 package.json / patch 资源即可）：
node_modules/@deepseek-ai/*/src/**
node_modules/@deepseek-ai/*/types/**
node_modules/@deepseek-ai/*/test/**
node_modules/@deepseek-ai/*/tests/**
node_modules/@deepseek-ai/*/lib/**/*.d.ts
node_modules/@deepseek-ai/*/lib/**/*.map
node_modules/@deepseek-ai/*/README.md
node_modules/@deepseek-ai/*/readme.md
node_modules/@deepseek-ai/*/CHANGELOG.md
node_modules/@deepseek-ai/*/LICENSE*
node_modules/cordis/src/**
node_modules/cordis/lib/**/*.d.ts
node_modules/cordis/lib/**/*.map
node_modules/schemastery/src/**
node_modules/schemastery/lib/**/*.d.ts
node_modules/schemastery/lib/**/*.map
node_modules/cosmokit/src/**
node_modules/cosmokit/lib/**/*.d.ts
node_modules/cosmokit/lib/**/*.map
node_modules/zod/src/**
node_modules/zod/lib/**/*.d.ts
node_modules/zod/lib/**/*.map
# 注意：不能通用裁剪 node_modules/*/src/** —— 部分包（如 koffi、debug、node-fetch）
# 的 main 直接指向 src/，裁掉会导致运行时 ERR_MODULE_NOT_FOUND、宿主启动失败。
# 只裁确认 main 在 lib/ 的包：
node_modules/cordis/src/**
node_modules/cordis/lib/**/*.d.ts
node_modules/cordis/lib/**/*.map
node_modules/schemastery/src/**
node_modules/schemastery/lib/**/*.d.ts
node_modules/schemastery/lib/**/*.map
node_modules/cosmokit/src/**
node_modules/cosmokit/lib/**/*.d.ts
node_modules/cosmokit/lib/**/*.map
node_modules/@deepseek-ai/*/src/**
node_modules/@deepseek-ai/*/test/**
node_modules/@deepseek-ai/*/tests/**
node_modules/@deepseek-ai/*/lib/**/*.d.ts
node_modules/@deepseek-ai/*/lib/**/*.map
node_modules/@deepseek-ai/*/README.md
node_modules/@deepseek-ai/*/readme.md
node_modules/@deepseek-ai/*/CHANGELOG.md
node_modules/@deepseek-ai/*/LICENSE*
# 非 scoped 包的文档/测试裁剪（保留 src/：main 可能指向它）
node_modules/*/test/**
node_modules/*/tests/**
node_modules/*/README.md
node_modules/*/readme.md
node_modules/*/CHANGELOG.md
node_modules/*/tsconfig.json
node_modules/*/.npmignore
node_modules/*/.gitignore
# scoped 包（@scope/name 两层路径）：只裁文档/测试/声明文件，不裁 src/
node_modules/@*/*/test/**
node_modules/@*/*/tests/**
node_modules/@*/*/README.md
node_modules/@*/*/readme.md
node_modules/@*/*/CHANGELOG.md
node_modules/@*/*/tsconfig.json
node_modules/@*/*/lib/**/*.d.ts
node_modules/@*/*/lib/**/*.map
